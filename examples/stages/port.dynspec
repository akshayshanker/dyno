@stage: port

R   @in R++
μ_Ψ @in R
σ_Ψ @in R+
μ_θ @in R
σ_θ @in R+
ρ_ζ @in [-1,1]
(Ψ @in R++, θ @in R++) @dist N((μ_Ψ, μ_θ),
                               ((σ_Ψ^2,       ρ_ζ*σ_Ψ*σ_θ),
                                (ρ_ζ*σ_Ψ*σ_θ, σ_θ^2)))

[id=g_ad, (k @in R++) @arvl -> (k_d @in R++) @dcsn] {
    k_d = k
}

[id=g_dc, (k_d, ς @control @in [0,1], Ψ, θ) @dcsn -> (m @in R++) @cntn] {
    m = k_d*(ς*Ψ + (1-ς)*R) + θ
}

[id=G_dc, (V[>] @in R) @cntn -> (V @in R) @dcsn] {
    V = E_{Ψ,θ}(V[>])               :: [id=value]
}

[id=G_ad, (V) @dcsn -> (V[<] @in R) @arvl] {
    V[<] = V
}

[id=pol, (V[>], dV[>] @in R++) -> (ς)] {
    ς     = argmax_{ς}(E_{Ψ,θ}(V[>]))  :: [id=objective]
    foc_ς = E_{Ψ,θ}(dV[>]*(Ψ - R))     :: [id=foc]
}
