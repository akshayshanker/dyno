@stage: ret_choice

δ @in R+

[id=g_ad, (a @in R+) @arvl -> (a_d @in R+) @dcsn] {
    a_d = a
}

[id=g_dc, (a_d, d @control @in {work, retire}) @dcsn -> ()] {
    [label=work,   () -> (a_w @in R+) @cntn] { a_w = a_d }
    [label=retire, () -> (a_r @in R+) @cntn] { a_r = a_d }
}

[id=G_dc, (V_w[>] @in R, V_r[>] @in R, d) @cntn -> (V @in R) @dcsn] {
    V = (V_w[>] - δ, V_r[>])[d]      :: [id=choice_value]
}

[id=G_ad, (V) @dcsn -> (V[<] @in R) @arvl] {
    V[<] = V
}

[id=pol, (V_w[>], V_r[>]) -> (d)] {
    d = argmax_{d}(V_w[>] - δ, V_r[>]) :: [id=choice]
}
